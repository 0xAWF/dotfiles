{
  "global": {
    "show_in_menu_bar": true
  },
  "profiles": [
    {
      "name": "Default profile",
      "selected": true,
      "virtual_hid_keyboard": { "keyboard_type_v2": "iso" },
      "complex_modifications": {
        "rules": [
          {
            "description": "Caps Lock -> Super (shift + control + option + command)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"] } },
                "to": [
                  {
                    "key_code": "left_shift",
                    "modifiers": ["left_command", "left_control", "left_option"]
                  }
                ]
              }
            ]
          },
          {
            "description": "Super + w + h/j/k/l/enter -> window tiling (via Rectangle)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "w", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "to": [{ "set_variable": { "name": "super_w_mode", "value": 1 } }],
                "to_after_key_up": [{ "set_variable": { "name": "super_w_mode", "value": 0 } }]
              },
              {
                "type": "basic",
                "from": { "key_code": "h", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "conditions": [{ "type": "variable_if", "name": "super_w_mode", "value": 1 }],
                "to": [{ "shell_command": "open -g 'rectangle://execute-action?name=left-half'" }]
              },
              {
                "type": "basic",
                "from": { "key_code": "j", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "conditions": [{ "type": "variable_if", "name": "super_w_mode", "value": 1 }],
                "to": [{ "shell_command": "open -g 'rectangle://execute-action?name=bottom-half'" }]
              },
              {
                "type": "basic",
                "from": { "key_code": "k", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "conditions": [{ "type": "variable_if", "name": "super_w_mode", "value": 1 }],
                "to": [{ "shell_command": "open -g 'rectangle://execute-action?name=top-half'" }]
              },
              {
                "type": "basic",
                "from": { "key_code": "l", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "conditions": [{ "type": "variable_if", "name": "super_w_mode", "value": 1 }],
                "to": [{ "shell_command": "open -g 'rectangle://execute-action?name=right-half'" }]
              },
              {
                "type": "basic",
                "from": { "key_code": "return_or_enter", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "conditions": [{ "type": "variable_if", "name": "super_w_mode", "value": 1 }],
                "to": [{ "shell_command": "open -g 'rectangle://execute-action?name=maximize'" }]
              }
            ]
          },
          {
            "description": "Super + key -> focus app, press again to cycle its windows",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "3", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^org\\.mozilla\\.firefox$"] }],
                "to": [{ "key_code": "equal_sign", "modifiers": ["left_command", "left_shift"] }]
              },
              {
                "type": "basic",
                "from": { "key_code": "3", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "to": [{ "shell_command": "open -a 'Firefox'" }]
              },

              {
                "type": "basic",
                "from": { "key_code": "2", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.mitchellh\\.ghostty$"] }],
                "to": [{ "key_code": "equal_sign", "modifiers": ["left_command", "left_shift"] }]
              },
              {
                "type": "basic",
                "from": { "key_code": "2", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "to": [{ "shell_command": "open -a 'Ghostty'" }]
              },

              {
                "type": "basic",
                "from": { "key_code": "4", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.hnc\\.Discord$"] }],
                "to": [{ "key_code": "equal_sign", "modifiers": ["left_command", "left_shift"] }]
              },
              {
                "type": "basic",
                "from": { "key_code": "4", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "to": [{ "shell_command": "open -a 'Discord'" }]
              },

              {
                "type": "basic",
                "from": { "key_code": "1", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^md\\.obsidian$"] }],
                "to": [{ "key_code": "equal_sign", "modifiers": ["left_command", "left_shift"] }]
              },
              {
                "type": "basic",
                "from": { "key_code": "1", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "to": [{ "shell_command": "open -a 'Obsidian'" }]
              },

              {
                "type": "basic",
                "from": { "key_code": "5", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^org\\.whispersystem\\.signal-desktop$"] }],
                "to": [{ "key_code": "equal_sign", "modifiers": ["left_command", "left_shift"] }]
              },
              {
                "type": "basic",
                "from": { "key_code": "5", "modifiers": { "mandatory": ["command", "control", "option", "shift"] } },
                "to": [{ "shell_command": "open -a 'Signal'" }]
              }
            ]
          }
        ]
      }
    }
  ]
}
